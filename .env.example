# VibeStudio local environment example.
# Copy this file to .env.local and fill only the values you need.

# Provider API keys are normally entered in the VibeStudio Keys panel.
# They are stored locally under workspace/default/.vibeframe/config.yaml.
# Do not commit workspace/ or .env.local.

# Optional: use a local VibeFrame CLI checkout instead of the pinned @vibeframe/cli dependency.
# VIBEFRAME_CLI_COMMAND="/path/to/vibeframe/node_modules/.bin/tsx /path/to/vibeframe/packages/cli/src/index.ts"

# Optional: storyboard drafting model.
# OPENAI_STORYBOARD_MODEL="gpt-5.4-mini"

# Cloudflare R2 publish settings.
# R2_ENDPOINT is the account-level S3 API endpoint, without the bucket path.
# Example: https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vibestudio-runs"
R2_REGION="auto"
R2_ENDPOINT=""

# Public read URL for generated run assets.
# Use a custom domain for production, or the public development URL for testing.
# Examples:
# R2_PUBLIC_BASE_URL="https://runs.example.com"
# R2_PUBLIC_BASE_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
R2_PUBLIC_BASE_URL=""
